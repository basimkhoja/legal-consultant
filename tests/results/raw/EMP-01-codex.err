from pathlib import Path
p=Path('references/jurisdictions/ksa/labor-law-implementing-regulations.md')
for l in p.read_text().splitlines():
 if l.startswith('|') and any(k in l.split('|')[1] for k in ['19','22','24','25','Annex 1','Annex 5']):
  c=l.split('|')
  if len(c)==7: print(' | '.join([c[1],c[2],c[4],c[5]]))
