/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
s=Path('references/jurisdictions/ksa/labor-law.md').read_text().splitlines()
for l in s:
 if l.startswith('| Art') and any(l.startswith('| '+x) for x in ['Arts. 55','Art. 54','Art. 64','Arts. 66','Art. 74','Art. 75','Art. 76','Art. 77','Art. 78','Art. 80','Art. 82']):
  c=l.split('|'); print(' | '.join([c[1],c[2],c[4],c[5]]))
