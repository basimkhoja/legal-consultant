from pathlib import Path
wanted={'labor-law.md':['Art. 83'], 'government-tenders-procurement-law.md':['Art. 1','Art. 10','Art. 11','Art. 93','Art. 72'], 'commercial-agencies-law.md':['Art. 1','Art. 3','Added Art. 2']}
for name,terms in wanted.items():
 print(name)
 for i,l in enumerate((Path('references/jurisdictions/ksa')/name).read_text().splitlines(),1):
  if any(t in l.split('|')[1] for t in terms) if l.startswith('|') and len(l.split('|'))>2 else False:
   print(i,l)
PY" in /Users/basimkhoja/Projects/Legal Consultant
