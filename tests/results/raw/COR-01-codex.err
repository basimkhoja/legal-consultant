import runpy,re,concurrent.futures
f=runpy.run_path('scripts/fetch-law.py')
jobs=[('labor','08381293-6388-48e2-8ad2-a9a700f2aa94',['المادة الثامنة عشرة','المادة الثالثة والثلاثون','المادة الحادية والخمسون','المادة الرابعة والثمانون','المادة التاسعة والعشرون بعد المائتين']),('bankruptcy','68204119-84f1-4789-8fad-a9ec014c3788',['المادة العاشرة بعد المائتين','المادة الحادية عشرة بعد المائتين','المادة الثانية عشرة بعد المائتين','المادة السابعة والعشرون بعد المائتين'])]
def get(j):
 n,g,titles=j;raw=f['curl']('https://laws.boe.gov.sa/BoeLaws/Laws/LawDetails/'+g+'/1');out=[]
 for b in re.split(r'(?=<div["'^>]*class="article_item(?: |"))'"',raw):
  if not re.match(r'<div["'^>]*class="article_item(?: |")'"',b):continue
  m=re.search(r'<h3["'^>]*>(.*?)</h3>'"',b,re.S);title=f['_html_to_text'](m.group(1)) if m else ''
  if any(title.startswith(t) for t in titles):out.append(f['_html_to_text'](b))
 return n,out
with concurrent.futures.ThreadPoolExecutor(max_workers=2) as ex:
 for n,out in ex.map(get,jobs):
  print('LAW',n)
  for b in out:print(b)
